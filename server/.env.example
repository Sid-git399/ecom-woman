# Database
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/

# Session signature. Use at least 32 characters.
JWT_SECRET=replace_with_a_long_random_string

# Allowed client origins, comma-separated.
CLIENT_URLS=http://localhost:5173,https://your-domain.com

PORT=5000
NODE_ENV=development

# Cloudinary uploads
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Admin account seeded on first run
ADMIN_PHONE=0550000000
ADMIN_NAME=Administration
ADMIN_PASSWORD=ChangeMe123456
